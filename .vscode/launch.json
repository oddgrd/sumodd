{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe-rs launch",
            "cwd": "${workspaceFolder}",
            "speed": 4600,
            "runtimeExecutable": "probe-rs",
            "runtimeArgs": [
                "dap-server"
            ],
            "chip": "STM32F303K8TX",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": false,
                "formatOptions": {
                    "binaryFormat": "elf"
                }
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "build/debug/sumo.elf",
                    // Allows us to view peripheral registers in the debug variables.
                    "svdFile": "STM32F303.svd"
                }
            ],
            "env": {},
            "consoleLogLevel": "Console",
        },
        {
            "type": "probe-rs-debug",
            "request": "attach",
            "name": "probe-rs attach",
            "cwd": "${workspaceFolder}",
            "speed": 4600,
            "chip": "STM32F303K8TX",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "build/debug/sumo.elf",
                    // Allows us to view peripheral registers in the debug variables.
                    "svdFile": "STM32F303.svd"
                }
            ],
            "env": {},
            "consoleLogLevel": "Console",
        }
    ]
}