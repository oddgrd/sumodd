BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100

SortIncludes: true
IncludeBlocks: Regroup
# Brackets always start on next line.
BreakBeforeBraces: Allman
AllowShortFunctionsOnASingleLine: None
AllowShortEnumsOnASingleLine: false

IncludeCategories:
  - Regex: '^<.*>$'
    Priority: 1

  - Regex: '^".*"$'
    Priority: 2